# Supabase project for auth, backend and database (Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Flutterwave checkout (Publishable key -> Settings -> API keys)
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Server-only (Vercel Project Settings -> Environment Variables)
# Webhook hash from Flutterwave Dashboard -> Settings -> Webhooks
FLUTTERWAVE_WEBHOOK_SECRET=
# Secret key, used by the webhook to re-verify every transaction (optional but recommended)
FLUTTERWAVE_SECRET_KEY=
# Supabase service role key (Settings -> API) - server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
